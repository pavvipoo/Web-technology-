# Supabase environment variables (copy into client/.env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# If you have server-side functions that need admin key, keep it secret and do NOT commit it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (DO NOT COMMIT)

# URL of the deployed Supabase Edge Function for RepoChat (optional)
# Example: https://<project>.functions.supabase.co/repoChat
VITE_REPOCHAT_URL=
